{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-network-benchmark.local/contracts/campaign-manifest.schema.json",
  "title": "Campaign Manifest",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "aggregate_state": { "const": "succeeded" } }, "required": ["aggregate_state"] },
      "then": { "properties": { "child_runs": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": {
          "aggregate_state": { "const": "succeeded" },
          "selected_providers": { "contains": { "const": "aws" } }
        },
        "required": ["aggregate_state", "selected_providers"]
      },
      "then": { "properties": { "child_runs": { "contains": { "properties": { "provider": { "const": "aws" } }, "required": ["provider"] } } } }
    },
    {
      "if": {
        "properties": {
          "aggregate_state": { "const": "succeeded" },
          "selected_providers": { "contains": { "const": "azure" } }
        },
        "required": ["aggregate_state", "selected_providers"]
      },
      "then": { "properties": { "child_runs": { "contains": { "properties": { "provider": { "const": "azure" } }, "required": ["provider"] } } } }
    },
    {
      "if": {
        "properties": {
          "aggregate_state": { "const": "succeeded" },
          "selected_providers": { "contains": { "const": "gcp" } }
        },
        "required": ["aggregate_state", "selected_providers"]
      },
      "then": { "properties": { "child_runs": { "contains": { "properties": { "provider": { "const": "gcp" } }, "required": ["provider"] } } } }
    }
  ],
  "required": [
    "manifest_type",
    "schema_version",
    "campaign_id",
    "experiment_id",
    "configuration_role",
    "scheduled_start",
    "selected_providers",
    "scenario",
    "config_provenance",
    "tool_versions",
    "aggregate_state",
    "child_runs",
    "created_at",
    "updated_at",
    "lifecycle_events"
  ],
  "properties": {
    "manifest_type": { "const": "campaign" },
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "experiment_id": { "type": "string", "pattern": "^EXP-[0-9]{3,}$" },
    "configuration_role": { "enum": ["experiment", "test"] },
    "scheduled_start": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "selected_providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/provider" }
    },
    "scenario": { "$ref": "#/$defs/scenario" },
    "config_provenance": { "$ref": "#/$defs/config_provenance" },
    "tool_versions": { "$ref": "#/$defs/structured_evidence" },
    "aggregate_state": { "$ref": "#/$defs/campaign_state" },
    "child_runs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/child_reference" }
    },
    "created_at": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "updated_at": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "lifecycle_events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycle_event" }
    }
  },
  "$defs": {
    "provider": { "enum": ["aws", "azure", "gcp"] },
    "scenario": {
      "enum": [
        "same_zone",
        "cross_zone",
        "placement_optimization",
        "inter_region"
      ]
    },
    "campaign_state": {
      "enum": [
        "initialized",
        "active",
        "partially_complete",
        "succeeded",
        "failed",
        "interrupted"
      ]
    },
    "evidence_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailable_reason"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "unavailable_reason": { "type": ["string", "null"] }
      },
      "oneOf": [
        {
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "unavailable_reason": { "type": "null" }
          }
        },
        {
          "properties": {
            "value": { "type": "null" },
            "unavailable_reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "structured_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unavailable_reason"],
      "properties": {
        "value": { "type": ["object", "null"] },
        "unavailable_reason": { "type": ["string", "null"] }
      },
      "oneOf": [
        {
          "properties": {
            "value": { "type": "object", "minProperties": 1 },
            "unavailable_reason": { "type": "null" }
          }
        },
        {
          "properties": {
            "value": { "type": "null" },
            "unavailable_reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "config_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "sha256",
        "byte_length",
        "snapshot_path",
        "implementation_git_commit",
        "design_git_commit"
      ],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "snapshot_path": { "type": "null" },
        "implementation_git_commit": { "$ref": "#/$defs/evidence_value" },
        "design_git_commit": { "$ref": "#/$defs/evidence_value" }
      }
    },
    "child_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "run_id", "manifest_path", "result_path"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "run_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)\\.\\.?(/|$))(?:/[^/]+(?:/[^/]+)*|[^/]+(?:/[^/]+)*)$" },
        "result_path": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)\\.\\.?(/|$))(?:/[^/]+(?:/[^/]+)*|[^/]+(?:/[^/]+)*)$" }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "aws" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "run_id": { "pattern": "^.+-aws$" },
              "manifest_path": { "pattern": "(^|/)manifests/[^/]+-aws\\.json$" },
              "result_path": { "pattern": "(^|/)raw/[^/]+-aws$" }
            }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "azure" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "run_id": { "pattern": "^.+-azure$" },
              "manifest_path": { "pattern": "(^|/)manifests/[^/]+-azure\\.json$" },
              "result_path": { "pattern": "(^|/)raw/[^/]+-azure$" }
            }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "gcp" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "run_id": { "pattern": "^.+-gcp$" },
              "manifest_path": { "pattern": "(^|/)manifests/[^/]+-gcp\\.json$" },
              "result_path": { "pattern": "(^|/)raw/[^/]+-gcp$" }
            }
          }
        }
      ]
    },
    "lifecycle_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_domain", "state", "occurred_at", "detail"],
      "properties": {
        "state_domain": { "const": "campaign" },
        "state": { "$ref": "#/$defs/campaign_state" },
        "occurred_at": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
