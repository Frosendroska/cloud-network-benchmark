    "ExpiryEvidence": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "stop",
            "deallocate"
          ],
          "title": "Action",
          "type": "string"
        },
        "deployment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Deployment Id",
          "type": "string"
