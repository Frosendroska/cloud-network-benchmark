{
  "$defs": {
    "ArtifactExpectation": {
      "enum": [
        "required",
        "optional",
        "not_expected"
      ],
      "title": "ArtifactExpectation",
      "type": "string"
    },
    "ArtifactInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "expectation": {
          "$ref": "#/$defs/ArtifactExpectation"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "path_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Template"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmRole"
            },
            {
              "const": "controller",
              "type": "string"
            }
          ],
          "title": "Producer"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "producer",
        "expectation"
      ],
      "title": "ArtifactInput",
      "type": "object"
    },
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "closed": {
          "title": "Closed",
          "type": "boolean"
        },
        "deployment_id": {
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmRole"
            },
            {
              "const": "controller",
              "type": "string"
            }
          ],
          "title": "Producer"
        },
        "retrieval_state": {
          "enum": [
            "not_retrieved",
            "verified",
            "failed"
          ],
          "title": "Retrieval State",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "size_bytes": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Id"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "kind",
        "producer",
        "unit_id",
        "deployment_id",
        "closed",
        "size_bytes",
        "sha256",
        "retrieval_state"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "BenchmarkPhase": {
      "enum": [
        "idle_latency",
        "single_flow",
        "multi_flow"
      ],
      "title": "BenchmarkPhase",
      "type": "string"
    },
    "CleanupState": {
      "enum": [
        "not_started",
        "not_required",
        "attempted",
        "succeeded",
        "failed"
      ],
