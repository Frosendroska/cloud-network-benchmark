          "default": null,
          "title": "Gap Reason"
        },
        "interface_rx_drops": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "interface_rx_errors": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "interface_tx_drops": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "interface_tx_errors": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "interval_seconds": {
          "exclusiveMinimum": 0,
          "title": "Interval Seconds",
          "type": "number"
        },
        "monotonic_seconds": {
          "minimum": 0,
          "title": "Monotonic Seconds",
          "type": "number"
        },
        "reset_fields": {
          "items": {
            "type": "string"
          },
          "title": "Reset Fields",
          "type": "array"
        },
        "rx_bytes": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "tcp_retransmissions": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "tx_bytes": {
          "$ref": "#/$defs/Evidence_int_"
        },
        "vm_role": {
          "$ref": "#/$defs/VmRole"
        }
      },
      "required": [
        "deployment_id",
        "vm_role",
        "sampled_at",
        "monotonic_seconds",
        "interval_seconds",
        "cpu_total_percent",
        "cpu_max_core_percent",
        "cpu_steal_percent",
        "tcp_retransmissions",
        "interface_rx_drops",
        "interface_tx_drops",
        "interface_rx_errors",
        "interface_tx_errors",
        "rx_bytes",
        "tx_bytes"
      ],
      "title": "DiagnosticSample",
      "type": "object"
    },
