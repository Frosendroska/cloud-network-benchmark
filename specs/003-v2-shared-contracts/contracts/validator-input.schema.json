        "deployment_id": {
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
        },
        "finished_at": {
          "$ref": "#/$defs/Evidence_datetime_"
        },
        "monotonic_finished": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "monotonic_started": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmRole"
            },
            {
              "const": "controller",
              "type": "string"
            }
          ],
          "title": "Producer"
        },
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "started_at": {
          "$ref": "#/$defs/Evidence_datetime_"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        }
      },
      "required": [
        "request",
        "result",
        "producer",
        "deployment_id",
        "binary_version",
        "source_identity",
        "monotonic_started",
        "monotonic_finished"
      ],
      "title": "CommandEvidence",
      "type": "object"
    },
    "ComparisonEligibility": {
      "enum": [
        "not_evaluated",
        "eligible",
        "ineligible",
        "unavailable"
      ],
      "title": "ComparisonEligibility",
      "type": "string"
    },
    "DataValidity": {
      "enum": [
        "not_validated",
        "valid",
        "partial",
        "invalid",
        "unavailable"
