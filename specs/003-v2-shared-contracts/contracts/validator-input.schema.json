      "type": "string"
    },
    "DiagnosticSample": {
      "additionalProperties": false,
      "properties": {
        "cpu_max_core_percent": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "cpu_steal_percent": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "cpu_total_percent": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "deployment_id": {
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
        },
        "gap_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
