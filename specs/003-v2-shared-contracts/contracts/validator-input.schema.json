        "monotonic_seconds",
        "utc_timestamp",
        "estimated_error_ms",
        "synchronization_source"
      ],
      "title": "ClockMapping",
      "type": "object"
    },
    "CommandEvidence": {
      "additionalProperties": false,
      "properties": {
        "binary_version": {
          "$ref": "#/$defs/Evidence_str_"
