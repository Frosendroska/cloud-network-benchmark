    },
    "Provider": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "Provider",
      "type": "string"
    },
    "Scenario": {
      "enum": [
        "same_zone",
        "cross_zone",
        "placement_optimization",
        "inter_region"
      ],
      "title": "Scenario",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "timing_profile": {
            "const": "azure_exp901_sweden_acceptance_v1"
          }
        },
        "required": [
          "timing_profile"
        ]
      },
      "then": {
        "properties": {
          "config_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "context": {
            "const": "failure_check"
          },
          "experiment_id": {
            "const": "EXP-901"
          },
          "lifetime_cap_seconds": {
            "const": 1800
          },
          "mode": {
            "const": "acceptance"
          },
          "resolved_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "scenario": {
            "const": "same_zone"
          },
          "selected_providers": {
            "const": [
              "azure"
            ]
          }
        },
        "required": [
          "experiment_id",
          "context",
          "scenario",
          "config_sha256",
          "resolved_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "workflow_profile": {
            "const": "all_cloud_acceptance_v1"
          }
        },
        "required": [
          "workflow_profile"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 4200
          },
          "mode": {
            "const": "acceptance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_profile": {
            "const": "all_cloud_calibration_v1"
          }
        },
        "required": [
          "workflow_profile"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 5100
          },
          "mode": {
            "const": "calibration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_profile": {
            "const": "all_cloud_failure_acceptance_v1"
          }
        },
        "required": [
          "workflow_profile"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 3900
          },
          "mode": {
            "const": "acceptance"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "workflow_profile": {
                  "const": "all_cloud_acceptance_v1"
                }
              },
              "required": [
                "workflow_profile"
              ]
            },
            {
              "properties": {
                "workflow_profile": {
                  "const": "all_cloud_failure_acceptance_v1"
                }
              },
              "required": [
                "workflow_profile"
              ]
            },
            {
              "properties": {
                "timing_profile": {
                  "const": "azure_exp901_sweden_acceptance_v1"
                }
              },
              "required": [
                "timing_profile"
              ]
            }
          ]
        },
        "properties": {
          "mode": {
            "const": "acceptance"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 1200
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "short_study"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 1200
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "workflow_profile": {
                  "const": "all_cloud_calibration_v1"
                }
              },
              "required": [
                "workflow_profile"
              ]
            }
          ]
        },
        "properties": {
          "mode": {
            "const": "calibration"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 1800
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "diagnostic_day"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "lifetime_cap_seconds": {
            "const": 87600
          }
        }
      }
    }
  ],
  "properties": {
    "active_reserved_usd": {
      "$ref": "#/$defs/Evidence_float_"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "config_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Config Id",
      "type": "string"
    },
    "config_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Sha256"
    },
    "context": {
      "anyOf": [
        {
          "enum": [
            "standard",
            "failure_check",
            "replacement"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "estimated_cost_usd": {
      "$ref": "#/$defs/Evidence_float_"
    },
    "experiment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "incurred_cost_usd": {
      "$ref": "#/$defs/Evidence_float_"
    },
    "lifetime_cap_seconds": {
      "enum": [
        1200,
        1800,
        3900,
        4200,
        5100,
        87600
      ],
      "title": "Lifetime Cap Seconds",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/ExperimentMode"
    },
    "outstanding_cleanup": {
      "title": "Outstanding Cleanup",
      "type": "boolean"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Priority",
      "type": "string"
    },
    "resolved_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Sha256"
    },
    "scenario": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scenario"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schedule_entry_id": {
      "$ref": "#/$defs/Evidence_str_"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_providers": {
      "items": {
        "$ref": "#/$defs/Provider"
      },
      "minItems": 1,
      "title": "Selected Providers",
      "type": "array"
    },
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "timing_profile": {
      "anyOf": [
        {
          "const": "azure_exp901_sweden_acceptance_v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timing Profile"
    },
    "workflow_profile": {
      "anyOf": [
        {
          "enum": [
            "all_cloud_acceptance_v1",
            "all_cloud_calibration_v1",
            "all_cloud_failure_acceptance_v1"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Profile"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "config_id",
    "schedule_entry_id",
    "selected_providers",
    "mode",
    "priority",
    "lifetime_cap_seconds",
    "estimated_cost_usd",
    "source_path",
    "source_sha256",
    "incurred_cost_usd",
    "active_reserved_usd",
    "outstanding_cleanup"
  ],
  "title": "ReservationRequest",
  "type": "object"
}
