{
  "$defs": {
    "AdmissionRequirements": {
      "additionalProperties": false,
      "properties": {
        "cost_input_id": {
          "minLength": 1,
          "title": "Cost Input Id",
          "type": "string"
        },
        "cost_input_sha256": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "estimated_cost_usd": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "hard_budget_usd": {
          "const": 300,
          "default": 300,
          "title": "Hard Budget Usd",
          "type": "integer"
        },
        "lifetime_cap_seconds": {
          "enum": [
            1200,
            1800,
            87600
          ],
          "title": "Lifetime Cap Seconds",
          "type": "integer"
        },
        "prices_checked_on": {
          "format": "date",
          "title": "Prices Checked On",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "title": "Priority",
          "type": "string"
        },
        "protected_buffer_usd": {
          "const": 50,
          "default": 50,
          "title": "Protected Buffer Usd",
          "type": "integer"
        },
        "requires_common_n": {
          "title": "Requires Common N",
          "type": "boolean"
        },
        "requires_expiry": {
          "title": "Requires Expiry",
          "type": "boolean"
        },
        "requires_primary_review": {
          "title": "Requires Primary Review",
          "type": "boolean"
        },
        "requires_schedule": {
          "title": "Requires Schedule",
          "type": "boolean"
        }
      },
      "required": [
        "priority",
        "lifetime_cap_seconds",
        "cost_input_id",
        "prices_checked_on",
        "cost_input_sha256",
        "estimated_cost_usd",
        "requires_common_n",
        "requires_schedule",
        "requires_primary_review",
        "requires_expiry"
      ],
      "title": "AdmissionRequirements",
      "type": "object"
    },
    "CampaignState": {
      "enum": [
        "initialized",
        "active",
        "partially_complete",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "title": "CampaignState",
      "type": "string"
    },
    "ChildReference": {
      "additionalProperties": false,
      "properties": {
        "manifest_path": {
          "minLength": 1,
          "title": "Manifest Path",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "result_path": {
          "minLength": 1,
          "title": "Result Path",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "run_id",
        "manifest_path",
        "result_path"
      ],
      "title": "ChildReference",
      "type": "object"
    },
    "Evidence_Dict_str__Any__": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[Dict[str, Any]]",
      "type": "object"
    },
    "Evidence_ReservationEvidence_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReservationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Evidence[ReservationEvidence]",
      "type": "object"
    },
    "Evidence_ScheduleEntry_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Evidence[ScheduleEntry]",
      "type": "object"
    },
    "Evidence_bool_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[bool]",
      "type": "object"
    },
    "Evidence_datetime_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[datetime]",
      "type": "object"
    },
    "Evidence_float_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[float]",
      "type": "object"
    },
    "Evidence_str_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[str]",
      "type": "object"
    },
    "ExperimentMode": {
      "enum": [
        "acceptance",
        "calibration",
        "short_study",
        "diagnostic_day"
      ],
      "title": "ExperimentMode",
      "type": "string"
    },
    "GitSnapshot": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "diff_sha256": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "dirty": {
          "$ref": "#/$defs/Evidence_bool_"
        }
      },
      "required": [
        "commit",
        "dirty",
        "diff_sha256"
      ],
      "title": "GitSnapshot",
      "type": "object"
    },
    "LifecycleDomain": {
      "enum": [
        "campaign",
        "execution",
        "cleanup"
      ],
      "title": "LifecycleDomain",
      "type": "string"
    },
    "LifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "state_domain": {
          "$ref": "#/$defs/LifecycleDomain"
        }
      },
      "required": [
        "state_domain",
        "state",
        "occurred_at"
      ],
      "title": "LifecycleEvent",
      "type": "object"
    },
    "ManifestConfigProvenance": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "exclusiveMinimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "design_git": {
          "$ref": "#/$defs/GitSnapshot"
        },
        "design_git_commit": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "implementation_git": {
          "$ref": "#/$defs/GitSnapshot"
        },
        "implementation_git_commit": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "resolved_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resolved Sha256",
          "type": "string"
        },
        "resolved_snapshot_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Snapshot Path"
        },
        "resolved_snapshot_sha256": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "schedule_sha256": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "snapshot_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Path"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "sha256",
        "byte_length",
        "snapshot_path",
        "resolved_sha256",
        "resolved_snapshot_sha256",
        "resolved_snapshot_path",
        "implementation_git_commit",
        "design_git_commit"
      ],
      "title": "ManifestConfigProvenance",
      "type": "object"
    },
    "Provider": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "Provider",
      "type": "string"
    },
    "ReservationEvidence": {
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "cap_start_policy_id": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "cap_started_at": {
          "$ref": "#/$defs/Evidence_datetime_"
        },
        "expires_at": {
          "$ref": "#/$defs/Evidence_datetime_"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "reservation_id": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "reserved_cost_usd": {
          "$ref": "#/$defs/Evidence_float_"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "state": {
          "enum": [
            "not_evaluated",
            "reserved",
            "rejected",
            "released"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "reservation_id",
        "state",
        "reserved_cost_usd",
        "cap_started_at",
        "expires_at",
        "cap_start_policy_id",
        "source_path",
        "source_sha256"
      ],
      "title": "ReservationEvidence",
      "type": "object"
    },
    "Scenario": {
      "enum": [
        "same_zone",
        "cross_zone",
        "placement_optimization",
        "inter_region"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "ScheduleEntry": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "config_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Config Id",
          "type": "string"
        },
        "entry_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Entry Id",
          "type": "string"
        },
        "experiment_id": {
          "pattern": "^EXP-[0-9]{3,}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "original_header": {
          "title": "Original Header",
          "type": "string"
        },
        "original_row": {
          "title": "Original Row",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "title": "Priority",
          "type": "string"
        },
        "replaces_run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces Run Id"
        },
        "row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Row Sha256",
          "type": "string"
        },
        "scheduled_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scheduled Start"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "window_label": {
          "anyOf": [
            {
              "enum": [
                "night",
                "morning",
                "afternoon",
                "evening"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Label"
        }
      },
      "required": [
        "entry_id",
        "config_id",
        "experiment_id",
        "scheduled_start",
        "source_path",
        "source_sha256",
        "row_sha256",
        "original_header",
        "original_row",
        "columns",
        "priority"
      ],
      "title": "ScheduleEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "$ref": "#/$defs/AdmissionRequirements"
    },
    "aggregate_state": {
      "$ref": "#/$defs/CampaignState",
      "default": "initialized"
    },
    "campaign_id": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "title": "Campaign Id",
      "type": "string"
    },
    "child_runs": {
      "items": {
        "$ref": "#/$defs/ChildReference"
      },
      "maxItems": 3,
      "title": "Child Runs",
      "type": "array"
    },
    "config_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Config Id",
      "type": "string"
    },
    "config_provenance": {
      "$ref": "#/$defs/ManifestConfigProvenance"
    },
    "configuration_role": {
      "enum": [
        "experiment",
        "test"
      ],
      "title": "Configuration Role",
      "type": "string"
    },
    "context": {
      "enum": [
        "standard",
        "failure_check",
        "replacement"
      ],
      "title": "Context",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^EXP-[0-9]{3,}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "lifecycle_events": {
      "items": {
        "$ref": "#/$defs/LifecycleEvent"
      },
      "title": "Lifecycle Events",
      "type": "array"
    },
    "manifest_type": {
      "const": "campaign",
      "default": "campaign",
      "title": "Manifest Type",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ExperimentMode"
    },
    "reservation": {
      "$ref": "#/$defs/Evidence_ReservationEvidence_"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "schedule_entry": {
      "$ref": "#/$defs/Evidence_ScheduleEntry_"
    },
    "scheduled_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scheduled Start"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "selected_providers": {
      "items": {
        "$ref": "#/$defs/Provider"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Selected Providers",
      "type": "array"
    },
    "tool_versions": {
      "$ref": "#/$defs/Evidence_Dict_str__Any__"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "config_id",
    "mode",
    "context",
    "campaign_id",
    "experiment_id",
    "configuration_role",
    "scheduled_start",
    "schedule_entry",
    "admission",
    "selected_providers",
    "scenario",
    "config_provenance",
    "tool_versions",
    "child_runs",
    "created_at",
    "updated_at",
    "lifecycle_events"
  ],
  "title": "CampaignManifest",
  "type": "object"
}
