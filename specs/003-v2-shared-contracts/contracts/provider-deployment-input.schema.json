{
  "$defs": {
    "AccelerationIntent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ena",
            "accelerated_networking",
            "gvnic"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AccelerationIntent",
      "type": "object"
    },
    "CampaignOptions": {
      "additionalProperties": false,
      "properties": {
        "cleanup_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleanup Timeout Seconds"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "provisioning_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provisioning Timeout Seconds"
        },
        "readiness_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readiness Timeout Seconds"
        }
      },
      "title": "CampaignOptions",
      "type": "object"
    },
    "DiskIntent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "gp3",
            "StandardSSD_LRS_E4",
            "pd-balanced"
          ],
          "title": "Kind",
          "type": "string"
        },
        "size_gib": {
          "const": 32,
          "default": 32,
          "title": "Size Gib",
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DiskIntent",
      "type": "object"
    },
    "Evidence_str_": {
      "additionalProperties": false,
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[str]",
      "type": "object"
    },
    "ExperimentMode": {
      "enum": [
        "acceptance",
        "calibration",
        "short_study",
        "diagnostic_day"
      ],
      "title": "ExperimentMode",
      "type": "string"
    },
    "IdentityContext": {
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "config_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Config Id",
          "type": "string"
        },
        "deployment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "experiment_id": {
          "pattern": "^EXP-[0-9]{3,}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Observation Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provider"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replaces_run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces Run Id"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "config_id",
        "campaign_id",
        "observation_id",
        "run_id",
        "deployment_id"
      ],
      "title": "IdentityContext",
      "type": "object"
    },
    "NetworkIntent": {
      "additionalProperties": false,
      "properties": {
        "address_spaces": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Address Spaces",
          "type": "object"
        },
        "default_offloads": {
          "const": true,
          "default": true,
          "title": "Default Offloads",
          "type": "boolean"
        },
        "dscp": {
          "const": 0,
          "default": 0,
          "title": "Dscp",
          "type": "integer"
        },
        "ecn": {
          "const": false,
          "default": false,
          "title": "Ecn",
          "type": "boolean"
        },
        "mtu": {
          "const": 1460,
          "default": 1460,
          "title": "Mtu",
          "type": "integer"
        },
        "private_ipv4": {
          "const": true,
          "default": true,
          "title": "Private Ipv4",
          "type": "boolean"
        },
        "public_ipv4_per_vm": {
          "const": 1,
          "default": 1,
          "title": "Public Ipv4 Per Vm",
          "type": "integer"
        },
        "subnets": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Subnets",
          "type": "object"
        },
        "tcp_congestion_control": {
          "const": "cubic",
          "default": "cubic",
          "title": "Tcp Congestion Control",
          "type": "string"
        }
      },
      "required": [
        "address_spaces",
        "subnets"
      ],
      "title": "NetworkIntent",
      "type": "object"
    },
    "OperatingSystemIntent": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "amd64",
          "default": "amd64",
          "title": "Architecture",
          "type": "string"
        },
        "distribution": {
          "const": "ubuntu",
          "default": "ubuntu",
          "title": "Distribution",
          "type": "string"
        },
        "release": {
          "const": "24.04",
          "default": "24.04",
          "title": "Release",
          "type": "string"
        }
      },
      "title": "OperatingSystemIntent",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "collocated": {
          "default": false,
          "title": "Collocated",
          "type": "boolean"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "max_distance": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Distance"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Placement",
      "type": "object"
    },
    "Provider": {
      "enum": [
        "aws",
        "azure",
        "gcp"
      ],
      "title": "Provider",
      "type": "string"
    },
    "Scenario": {
      "enum": [
        "same_zone",
        "cross_zone",
        "placement_optimization",
        "inter_region"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "SecurityIntent": {
      "additionalProperties": false,
      "properties": {
        "batch_mode": {
          "const": true,
          "default": true,
          "title": "Batch Mode",
          "type": "boolean"
        },
        "benchmark_source": {
          "const": "vm_a_private",
          "default": "vm_a_private",
          "title": "Benchmark Source",
          "type": "string"
        },
        "controller_cidr": {
          "$ref": "#/$defs/Evidence_str_"
        },
        "iperf3_tcp_port": {
          "const": 5201,
          "default": 5201,
          "title": "Iperf3 Tcp Port",
          "type": "integer"
        },
        "sockperf_udp_port": {
          "const": 11111,
          "default": 11111,
          "title": "Sockperf Udp Port",
          "type": "integer"
        },
        "strict_host_key_checking": {
          "const": true,
          "default": true,
          "title": "Strict Host Key Checking",
          "type": "boolean"
        }
      },
      "required": [
        "controller_cidr"
      ],
      "title": "SecurityIntent",
      "type": "object"
    },
    "VmIntent": {
      "additionalProperties": false,
      "properties": {
        "acceleration": {
          "$ref": "#/$defs/AccelerationIntent"
        },
        "connection_user": {
          "minLength": 1,
          "title": "Connection User",
          "type": "string"
        },
        "disk": {
          "$ref": "#/$defs/DiskIntent"
        },
        "function": {
          "minLength": 1,
          "title": "Function",
          "type": "string"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/NetworkIntent"
        },
        "os": {
          "$ref": "#/$defs/OperatingSystemIntent"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/VmRole"
        },
        "security": {
          "$ref": "#/$defs/SecurityIntent"
        },
        "vm_shape": {
          "minLength": 1,
          "title": "Vm Shape",
          "type": "string"
        },
        "zone": {
          "minLength": 1,
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "role",
        "function",
        "region",
        "zone",
        "vm_shape",
        "image",
        "connection_user",
        "disk",
        "network",
        "security",
        "acceleration"
      ],
      "title": "VmIntent",
      "type": "object"
    },
    "VmRole": {
      "enum": [
        "vm_a",
        "vm_b"
      ],
      "title": "VmRole",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bootstrap_inputs": {
      "additionalProperties": true,
      "title": "Bootstrap Inputs",
      "type": "object"
    },
    "bootstrap_template": {
      "title": "Bootstrap Template",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_options": {
      "$ref": "#/$defs/CampaignOptions"
    },
    "child_result_path": {
      "title": "Child Result Path",
      "type": "string"
    },
    "cleanup_timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Timeout Seconds"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "context": {
      "enum": [
        "standard",
        "failure_check",
        "replacement"
      ],
      "title": "Context",
      "type": "string"
    },
    "design_git_commit": {
      "$ref": "#/$defs/Evidence_str_"
    },
    "experiment_id": {
      "pattern": "^EXP-[0-9]{3,}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/IdentityContext"
    },
    "implementation_git_commit": {
      "$ref": "#/$defs/Evidence_str_"
    },
    "mode": {
      "$ref": "#/$defs/ExperimentMode"
    },
    "placement": {
      "$ref": "#/$defs/Placement"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_options": {
      "additionalProperties": true,
      "title": "Provider Options",
      "type": "object"
    },
    "provisioning_timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provisioning Timeout Seconds"
    },
    "readiness_timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readiness Timeout Seconds"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "scheduled_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scheduled Start"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "terraform_directory": {
      "title": "Terraform Directory",
      "type": "string"
    },
    "vm_a": {
      "$ref": "#/$defs/VmIntent"
    },
    "vm_b": {
      "$ref": "#/$defs/VmIntent"
    }
  },
  "required": [
    "identity",
    "mode",
    "context",
    "campaign_id",
    "run_id",
    "experiment_id",
    "provider",
    "scenario",
    "scheduled_start",
    "vm_a",
    "vm_b",
    "placement",
    "provider_options",
    "campaign_options",
    "bootstrap_template",
    "terraform_directory",
    "child_result_path",
    "config_sha256",
    "implementation_git_commit",
    "design_git_commit"
  ],
  "title": "ProviderDeploymentInput",
  "type": "object"
}
