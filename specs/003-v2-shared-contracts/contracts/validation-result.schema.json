{
  "$defs": {
    "ComparisonEligibility": {
      "enum": [
        "not_evaluated",
        "eligible",
        "ineligible",
        "unavailable"
      ],
      "title": "ComparisonEligibility",
      "type": "string"
    },
    "DataValidity": {
      "enum": [
        "not_validated",
        "valid",
        "partial",
        "invalid",
        "unavailable"
      ],
      "title": "DataValidity",
      "type": "string"
    },
    "Evidence_Dict_str__Any__": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "unavailable_reason": {
              "type": "null"
            },
            "value": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "minProperties": 1,
                  "type": "object"
                }
              ],
              "default": null,
              "title": "Value"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "unavailable_reason": {
              "anyOf": [
                {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                }
              ],
              "default": null,
              "title": "Unavailable Reason"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "unavailable_reason"
          ]
        }
      ],
      "properties": {
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Evidence[Dict[str, Any]]",
      "type": "object"
    },
    "ExperimentMode": {
      "enum": [
        "acceptance",
        "calibration",
        "short_study",
        "diagnostic_day"
      ],
      "title": "ExperimentMode",
      "type": "string"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationStatus": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparison_eligibility": {
                "const": "eligible"
              }
            },
            "required": [
              "comparison_eligibility"
            ]
          },
          "then": {
            "properties": {
              "data_validity": {
                "const": "valid"
              }
            },
            "required": [
              "data_validity"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "data_validity"
              ]
            }
          },
          "then": {
            "properties": {
              "data_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "data_validity": {
                "enum": [
                  "not_validated",
                  "partial",
                  "invalid",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "comparison_eligibility"
              ]
            }
          },
          "then": {
            "properties": {
              "comparison_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparison_eligibility": {
                "enum": [
                  "not_evaluated",
                  "ineligible",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "comparison_reasons": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "comparison_eligibility": {
          "$ref": "#/$defs/ComparisonEligibility",
          "default": "not_evaluated"
        },
        "comparison_reasons": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Comparison Reasons",
          "type": "array"
        },
        "data_reasons": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Data Reasons",
          "type": "array"
        },
        "data_validity": {
          "$ref": "#/$defs/DataValidity",
          "default": "not_validated"
        }
      },
      "title": "ValidationStatus",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ValidationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/Evidence_Dict_str__Any__"
    },
    "mode": {
      "$ref": "#/$defs/ExperimentMode"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "validation_status",
    "evaluated_at"
  ],
  "title": "ValidationResult",
  "type": "object"
}
