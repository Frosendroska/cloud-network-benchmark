{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentityAndStockholmEc2Reads",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ReadCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ListIamRolesForPrefixPreflight",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    },
    {
      "Sid": "StockholmEc2Lifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreatePlacementGroup",
        "ec2:DeletePlacementGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ManageOnlyExperimentIdentityTagsInStockholm",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "cnb_run_id",
            "cnb_deployment_id",
            "cnb_namespace",
            "Name",
            "cnb_role"
          ]
        }
      }
    },
    {
      "Sid": "StopOrTerminateOnlyTaggedStockholmExperimentInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:eu-north-1:238360820461:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        },
        "Null": {
          "ec2:ResourceTag/cnb_run_id": "false",
          "ec2:ResourceTag/cnb_deployment_id": "false"
        }
      }
    },
    {
      "Sid": "StockholmSsmExpiryDocumentAndAutomation",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:DescribeDocument",
        "ssm:GetDocument",
        "ssm:DeleteDocument",
        "ssm:ListDocumentVersions",
        "ssm:DescribeDocumentPermission",
        "ssm:StartAutomationExecution",
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationExecutions",
        "ssm:StopAutomationExecution",
        "ssm:ListTagsForResource",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ExpiryRoleLifecycleBoundToBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::238360820461:policy/CNBExpiryRoleBoundary"
        }
      }
    },
    {
      "Sid": "ManageOnlyExpiryRolesAndTheirInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*"
    },
    {
      "Sid": "TagExpiryRolesOnlyWithRunAndDeploymentIdentityAtCreation",
      "Effect": "Allow",
      "Action": "iam:TagRole",
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["cnb_run_id", "cnb_deployment_id"]
        },
        "Null": {
          "aws:RequestTag/cnb_run_id": "false",
          "aws:RequestTag/cnb_deployment_id": "false"
        }
      }
    },
    {
      "Sid": "ReadExpiryRoleTags",
      "Effect": "Allow",
      "Action": "iam:ListRoleTags",
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*"
    },
    {
      "Sid": "PassOnlyExpiryRolesToSystemsManager",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ssm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PreventChangingExpiryRoleBoundaries",
      "Effect": "Deny",
      "Action": [
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::238360820461:role/cnb-expiry-*"
    }
  ]
}
